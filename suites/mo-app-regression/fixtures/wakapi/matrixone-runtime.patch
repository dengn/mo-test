diff --git a/config/matrixone.go b/config/matrixone.go
new file mode 100644
index 0000000..47c519b
--- /dev/null
+++ b/config/matrixone.go
@@ -0,0 +1,24 @@
+package config
+
+import (
+ "gorm.io/driver/mysql"
+ "gorm.io/gorm"
+)
+
+// MatrixOne omits foreign keys from table_constraints, but exposes them in
+// referential_constraints. Keep all FK creation/enforcement enabled.
+type matrixoneDialector struct { *mysql.Dialector }
+func (d matrixoneDialector) Migrator(db *gorm.DB) gorm.Migrator {
+ return matrixoneMigrator{d.Dialector.Migrator(db).(mysql.Migrator)}
+}
+type matrixoneMigrator struct { mysql.Migrator }
+func (m matrixoneMigrator) HasConstraint(value interface{}, name string) bool {
+ if m.Migrator.HasConstraint(value, name) { return true }
+ var count int64
+ err := m.RunWithValue(value, func(stmt *gorm.Statement) error {
+  constraint, table := m.GuessConstraintInterfaceAndTable(stmt, name)
+  if constraint != nil { name = constraint.GetName() }
+  return m.DB.Raw("SELECT COUNT(*) FROM information_schema.referential_constraints WHERE constraint_schema = ? AND table_name = ? AND constraint_name = ?",m.CurrentDatabase(),table,name).Row().Scan(&count)
+ })
+ return err == nil && count > 0
+}
