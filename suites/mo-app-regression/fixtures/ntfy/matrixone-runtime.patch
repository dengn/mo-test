+// matrixoneSelectAccessCacheUsersQuery builds the per-users cache-load query
+// with a "?, ?, ..." IN clause sized for n usernames.
+func matrixoneSelectAccessCacheUsersQuery(n int) string {
+	var sb strings.Builder
+	sb.WriteString("SELECT u.`user`, a.topic, a.`read`, a.`write` FROM user_access a JOIN `user` u ON u.id = a.user_id WHERE u.`user` IN (")
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			sb.WriteString(",")
+		}
+		sb.WriteString("?")
+	}
+	sb.WriteString(")")
+	return sb.String()
+}
