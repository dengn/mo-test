diff --git a/db/matrixone/matrixone.go b/db/matrixone/matrixone.go
new file mode 100644
--- /dev/null
+++ b/db/matrixone/matrixone.go
@@ -0,0 +1,50 @@
+// MatrixOne adaptation: explicit opt-in URL; no SQL proxy or fallback database.
+package matrixone
+
+import (
+	"database/sql"
+	"fmt"
+	"github.com/go-sql-driver/mysql"
+	"heckel.io/ntfy/v2/db"
+	"net/url"
+	"strings"
+	"time"
+)
+
+func IsURL(s string) bool { return strings.HasPrefix(s, "matrixone://") }
+func Open(raw string) (*db.Host, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "matrixone" || u.User == nil || u.Host == "" || u.Path == "" {
+		return nil, fmt.Errorf("invalid MatrixOne database URL")
+	}
+	cfg := mysql.NewConfig()
+	cfg.Net = "tcp"
+	cfg.Addr = u.Host
+	cfg.User = u.User.Username()
+	cfg.Passwd, _ = u.User.Password()
+	cfg.DBName = strings.TrimPrefix(u.Path, "/")
+	cfg.ParseTime = true
+	cfg.MultiStatements = true
+	cfg.InterpolateParams = true
+	cfg.Collation = "utf8mb4_general_ci"
+	cfg.Timeout = 10 * time.Second
+	cfg.ReadTimeout = 30 * time.Second
+	cfg.WriteTimeout = 30 * time.Second
+	d, err := sql.Open("mysql", cfg.FormatDSN())
+	if err != nil {
+		return nil, err
+	}
+	d.SetMaxOpenConns(10)
+	d.SetMaxIdleConns(10)
+	d.SetConnMaxLifetime(60 * time.Second)
+	var version string
+	if err = d.QueryRow("SELECT VERSION()").Scan(&version); err != nil {
+		d.Close()
+		return nil, err
+	}
+	if !strings.Contains(version, "MatrixOne") {
+		d.Close()
+		return nil, fmt.Errorf("MatrixOne backend requires actual MatrixOne server")
+	}
+	return &db.Host{Addr: u.Host, DB: d}, nil
+}
diff --git a/message/cache_matrixone.go b/message/cache_matrixone.go
new file mode 100644
--- /dev/null
+++ b/message/cache_matrixone.go
@@ -0,0 +1,81 @@
+// MatrixOne adaptation: native SQL and migration runner retained.
+package message
+
+import (
+	"heckel.io/ntfy/v2/db"
+	"heckel.io/ntfy/v2/db/schema"
+	"time"
+)
+
+const (
+	matrixoneSelectScheduledMessageIDsBySeqIDQuery        = "SELECT mid FROM messages WHERE topic = ? AND sequence_id = ? AND published = 0"
+	matrixoneDeleteScheduledBySequenceIDQuery             = "DELETE FROM messages WHERE topic = ? AND sequence_id = ? AND published = 0"
+	matrixoneUpdateMessagesForTopicExpiryQuery            = "UPDATE messages SET expires = ? WHERE topic = ?"
+	matrixoneSelectMessagesByIDQuery                      = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE mid = ?\n\t"
+	matrixoneSelectMessagesSinceTimeQuery                 = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE topic = ? AND time >= ? AND published = 1\n\t\tORDER BY time DESC, id DESC\n\t"
+	matrixoneSelectMessagesSinceTimeIncludeScheduledQuery = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE topic = ? AND time >= ?\n\t\tORDER BY time DESC, id DESC\n\t"
+	matrixoneSelectMessageRowIDQuery                      = "SELECT id FROM messages WHERE mid = ? LIMIT 1"
+	matrixoneSelectMessagesSinceIDQuery                   = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE topic = ? AND id > ? AND published = 1\n\t\tORDER BY time DESC, id DESC\n\t"
+	matrixoneSelectMessagesSinceIDIncludeScheduledQuery   = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE topic = ? AND (id > ? OR published = 0)\n\t\tORDER BY time DESC, id DESC\n\t"
+	matrixoneSelectMessagesLatestQuery                    = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE topic = ? AND published = 1\n\t\tORDER BY time DESC, id DESC\n\t\tLIMIT 1\n\t"
+	matrixoneSelectMessagesDueQuery                       = "\n\t\tSELECT mid, sequence_id, time, event, expires, topic, message, title, priority, tags, click, icon, actions, attachment_name, attachment_type, attachment_size, attachment_expires, attachment_url, sender, `user`, content_type, encoding\n\t\tFROM messages\n\t\tWHERE time <= ? AND published = 0\n\t\tORDER BY time, id\n\t"
+	matrixoneUpdateMessagePublishedQuery                  = "UPDATE messages SET published = 1 WHERE mid = ?"
+	matrixoneSelectMessagesCountQuery                     = "SELECT COUNT(*) FROM messages"
+	matrixoneSelectTopicsQuery                            = "SELECT topic FROM messages GROUP BY topic"
+
+	matrixoneDeleteExpiredMessagesQuery         = "DELETE FROM messages WHERE mid IN (SELECT mid FROM messages WHERE expires <= ? AND published = 1 LIMIT ?)"
+	matrixoneMarkExpiredAttachmentsDeletedQuery = "UPDATE messages SET attachment_deleted = 1 WHERE mid IN (SELECT mid FROM messages WHERE attachment_expires > 0 AND attachment_expires <= ? AND attachment_deleted = 0 LIMIT ?)"
+	matrixoneSelectAttachmentsSizeBySenderQuery = "SELECT IFNULL(SUM(attachment_size), 0) FROM messages WHERE `user` = '' AND sender = ? AND attachment_expires >= ?"
+	matrixoneSelectAttachmentsSizeByUserIDQuery = "SELECT IFNULL(SUM(attachment_size), 0) FROM messages WHERE `user` = ? AND attachment_expires >= ?"
+	matrixoneSelectAttachmentsWithSizesQuery    = "SELECT mid, attachment_size FROM messages WHERE attachment_expires > ? AND attachment_deleted = 0"
+
+	matrixoneSelectStatsQuery       = "SELECT value FROM stats WHERE `key` = 'messages'"
+	matrixoneUpdateStatsQuery       = "UPDATE stats SET value = ? WHERE `key` = 'messages'"
+	matrixoneUpdateMessageTimeQuery = "UPDATE messages SET time = ? WHERE mid = ?"
+)
+
+var matrixoneQueries = queries{
+	insertMessages:                   matrixoneInsertMessages,
+	selectScheduledMessageIDsBySeqID: matrixoneSelectScheduledMessageIDsBySeqIDQuery,
+	deleteScheduledBySequenceID:      matrixoneDeleteScheduledBySequenceIDQuery,
+	updateMessagesForTopicExpiry:     matrixoneUpdateMessagesForTopicExpiryQuery,
+	selectMessagesByID:               matrixoneSelectMessagesByIDQuery,
+	selectMessagesSinceTime:          matrixoneSelectMessagesSinceTimeQuery,
+	selectMessagesSinceTimeScheduled: matrixoneSelectMessagesSinceTimeIncludeScheduledQuery,
+	selectMessageRowID:               matrixoneSelectMessageRowIDQuery,
+	selectMessagesSinceID:            matrixoneSelectMessagesSinceIDQuery,
+	selectMessagesSinceIDScheduled:   matrixoneSelectMessagesSinceIDIncludeScheduledQuery,
+	selectMessagesLatest:             matrixoneSelectMessagesLatestQuery,
+	selectMessagesDue:                matrixoneSelectMessagesDueQuery,
+	deleteExpiredMessages:            matrixoneDeleteExpiredMessagesQuery,
+	updateMessagePublished:           matrixoneUpdateMessagePublishedQuery,
+	selectMessagesCount:              matrixoneSelectMessagesCountQuery,
+	selectTopics:                     matrixoneSelectTopicsQuery,
+	markExpiredAttachmentsDeleted:    matrixoneMarkExpiredAttachmentsDeletedQuery,
+	selectAttachmentsSizeBySender:    matrixoneSelectAttachmentsSizeBySenderQuery,
+	selectAttachmentsSizeByUserID:    matrixoneSelectAttachmentsSizeByUserIDQuery,
+	selectAttachmentsWithSizes:       matrixoneSelectAttachmentsWithSizesQuery,
+	selectStats:                      matrixoneSelectStatsQuery,
+	updateStats:                      matrixoneUpdateStatsQuery,
+	updateMessageTime:                matrixoneUpdateMessageTimeQuery,
+}
+
+func NewMatrixOneStore(d *db.DB, batchSize int, batchTimeout time.Duration) (*Cache, error) {
+	if err := schema.Migrate(d.Primary(), schema.MatrixOne, schemaStore, sqliteCurrentSchemaVersion, matrixoneCreateTables, nil); err != nil {
+		return nil, err
+	}
+	return newCache(d, matrixoneQueries, nil, batchSize, batchTimeout, false), nil
+}
+func matrixoneInsertMessages(rows int) string {
+	return insertMessagesQuery("messages", matrixoneInsertMessageColumns, rows, func(int) string { return "?" })
+}
+
+var matrixoneInsertMessageColumns = append([]string(nil), sqliteInsertMessageColumns...)
+
+func init() {
+	for i, col := range matrixoneInsertMessageColumns {
+		if col == "user" {
+			matrixoneInsertMessageColumns[i] = "`user`"
+		}
+	}
+}
