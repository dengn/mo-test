@@ -0,0 +1,29 @@
+package server
+
+import (
+	"heckel.io/ntfy/v2/user"
+	"net/http"
+)
+
+// Distinct from existing context keys. Only maybeAuthenticate for MatrixOne sets this.
+const contextRequestIdentity contextKey = 10101
+
+func requestUser(r *http.Request, v *visitor) *user.User {
+	if u, exists := r.Context().Value(contextRequestIdentity).(*user.User); exists {
+		return u
+	}
+	return v.User()
+}
+func requestUserID(r *http.Request, v *visitor) string {
+	if u := requestUser(r, v); u != nil {
+		return u.ID
+	}
+	return ""
+}
+func (s *Server) publishSyncEventForRequestAsync(v *visitor, u *user.User) {
+	go func() {
+		if err := s.publishSyncEventForUser(v, u); err != nil {
+			logv(v).Err(err).Trace("Error publishing to user's sync topic")
+		}
+	}()
+}
