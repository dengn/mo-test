{
  "version": 8,
  "name": "PG GIS application test",
  "center": [
    116.315,
    39.815
  ],
  "zoom": 12,
  "sources": {
    "points": {
      "type": "geojson",
      "data": "http://127.0.0.1:18880/collections/pg-points/items?f=json&limit=500"
    },
    "routes": {
      "type": "geojson",
      "data": "http://127.0.0.1:18880/collections/pg-routes/items?f=json&limit=500"
    },
    "zones": {
      "type": "geojson",
      "data": "http://127.0.0.1:18880/collections/pg-zones/items?f=json&limit=500"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e8ecef"
      }
    },
    {
      "id": "zones",
      "type": "fill",
      "source": "zones",
      "paint": {
        "fill-color": "#16a085",
        "fill-opacity": 0.25
      }
    },
    {
      "id": "routes",
      "type": "line",
      "source": "routes",
      "paint": {
        "line-color": "#ee8800",
        "line-width": 3
      }
    },
    {
      "id": "points",
      "type": "circle",
      "source": "points",
      "paint": {
        "circle-color": "#2266cc",
        "circle-radius": 4,
        "circle-stroke-width": 1,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}
