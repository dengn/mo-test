  "queries": {
    "sort_narrow": "SELECT id,k,amount FROM fact ORDER BY k DESC,id",
    "sort_wide": "SELECT id,k,amount,payload FROM fact WHERE id<=262144 ORDER BY payload DESC,id",
    "aggregate_high_cardinality": "SELECT grp,COUNT(*),SUM(amount),MIN(id),MAX(id) FROM fact GROUP BY grp ORDER BY grp",
    "aggregate_multi_distinct": "SELECT COUNT(DISTINCT id),COUNT(DISTINCT payload),SUM(amount) FROM fact",
    "aggregate_grouped_distinct": "SELECT grp,COUNT(DISTINCT k),COUNT(DISTINCT payload),SUM(amount) FROM fact GROUP BY grp ORDER BY grp",
    "aggregate_ordered": "SELECT grp,GROUP_CONCAT(id ORDER BY id SEPARATOR ',') FROM fact GROUP BY grp ORDER BY grp",
    "window_partitioned": "SELECT id,grp,SUM(amount) OVER(PARTITION BY grp ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM fact WHERE id<=262144 ORDER BY id",
    "join_inner": "SELECT COUNT(*),SUM(p.payload),SUM(b.payload) FROM probe_keys p JOIN build_keys b ON p.k=b.k",
    "join_left": "SELECT COUNT(*),SUM(p.payload),SUM(b.payload) FROM probe_keys p LEFT JOIN build_keys b ON p.k=b.k",
    "join_right": "SELECT COUNT(*),SUM(p.payload),SUM(b.payload) FROM probe_keys p RIGHT JOIN build_keys b ON p.k=b.k",
    "join_full": "SELECT COUNT(*),SUM(p.payload),SUM(b.payload) FROM probe_keys p FULL JOIN build_keys b ON p.k=b.k",
    "join_semi": "SELECT COUNT(*),SUM(payload) FROM probe_keys p WHERE p.k IN (SELECT b.k FROM build_keys b)",
    "join_anti_null_safe": "SELECT COUNT(*),SUM(payload) FROM probe_keys p WHERE NOT EXISTS(SELECT 1 FROM build_keys b WHERE b.k=p.k)",
    "join_not_in_null": "SELECT COUNT(*),SUM(payload) FROM probe_keys p WHERE p.k NOT IN (SELECT b.k FROM build_keys b)"
  },
